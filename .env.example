# Copy to .env (gitignored) and fill in. `react-router dev` loads .env into process.env.

# Knock: in-app Notifications. Use the keys from Knock's Development environment
# (dashboard.knock.app > Development > Platform > API keys).
# With these unset, Cadence sends no Notifications and hides the bell.

# Secret API key (sk_…). Server only.
KNOCK_API_KEY=
# Public API key (pk_…). Safe to send to the browser.
KNOCK_PUBLIC_API_KEY=
# Application Signing Key, base-64 encoded PEM (single line). Server only.
# Signs feed user tokens for enhanced security mode.
KNOCK_SIGNING_KEY=
# In-app feed channel id (UUID), from Channels and sources.
KNOCK_FEED_CHANNEL_ID=
